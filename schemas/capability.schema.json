{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marioypolo-ui/web-extraction-capabilities/schemas/capability.schema.json",
  "type": "object",
  "required": [
    "id",
    "version",
    "type",
    "scope",
    "status",
    "detection",
    "appliesTo",
    "notAppliesTo",
    "requirements",
    "verifiedTargets",
    "implementation",
    "fixtures",
    "tests"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "type": { "type": "string" },
    "scope": { "enum": ["generic", "platform-family", "site-specific"] },
    "status": { "enum": ["supported", "conditional", "human-required", "unsupported"] },
    "detection": { "type": "array", "items": { "type": "string" } },
    "appliesTo": { "type": "array", "items": { "type": "string" } },
    "notAppliesTo": { "type": "array", "items": { "type": "string" } },
    "requirements": { "type": "object" },
    "verifiedTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "referenceUrl",
          "match",
          "verification",
          "verifiedAt",
          "evidence"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "referenceUrl": { "type": "string", "format": "uri" },
          "match": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "pathPrefix": { "type": "string", "pattern": "^/" },
              "hashPrefix": { "type": "string", "pattern": "^#" }
            },
            "additionalProperties": false
          },
          "verification": {
            "enum": ["fixture-tested", "live-tested", "reported"]
          },
          "verifiedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "implementation": { "type": "string" },
    "fixtures": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
