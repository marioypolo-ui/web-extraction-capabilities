{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marioypolo-ui/web-extraction-capabilities/schemas/contribution-receipt.schema.json",
  "title": "Local contribution receipt v1",
  "description": "Current local API shapes. No receipt is proof of release/adoption. A received receipt only confirms storage. Verify trust/source before using any externally supplied JSON.",
  "type": "object",
  "properties": {
    "receiptVersion": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready-for-independent-validation",
        "needs-evidence",
        "blocked",
        "rejected",
        "needs-disclosure-review",
        "verified",
        "received",
        "recorded",
        "not-found"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
      }
    },
    "verifiedContribution": {
      "type": "boolean"
    },
    "publicReady": {
      "type": "boolean"
    },
    "reusable": {
      "const": false
    },
    "contributionKind": {
      "enum": [
        "capability",
        "website-reference"
      ]
    },
    "capabilityId": {
      "type": "string"
    },
    "capabilityVersion": {
      "type": "string"
    },
    "packSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "disclosureStatus": {
      "enum": [
        "local-only",
        "reviewed-for-publication"
      ]
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baselineManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runnerImage": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "todo": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "tests",
        "passed",
        "failed",
        "skipped",
        "todo",
        "cancelled"
      ],
      "additionalProperties": false
    },
    "integrationStatus": {
      "const": "pending-review"
    },
    "contributionKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "duplicate": {
      "type": "boolean"
    },
    "verification": {
      "$ref": "#/$defs/compact"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "mergeStatus": {
      "const": "not-recorded"
    },
    "releaseStatus": {
      "const": "not-recorded"
    }
  },
  "required": [
    "receiptVersion",
    "ok",
    "status",
    "verifiedContribution"
  ],
  "additionalProperties": false,
  "$defs": {
    "compact": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "needs-evidence",
            "blocked",
            "rejected",
            "needs-disclosure-review",
            "verified"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
          }
        },
        "verifiedContribution": {
          "type": "boolean"
        },
        "publicReady": {
          "type": "boolean"
        },
        "reusable": {
          "const": false
        }
      },
      "required": [
        "ok",
        "status",
        "reasons",
        "verifiedContribution",
        "publicReady",
        "reusable"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(result-shape|case-shape|diagnostics|records-shape|record-count|record-[0-9]+|empty-diagnostic|document)$"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "passed"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "baselineMatched": {
          "type": "boolean"
        },
        "candidatePassed": {
          "type": "boolean"
        },
        "baselineChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "candidateChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "required": [
        "index",
        "baselineMatched",
        "candidatePassed",
        "baselineChecks",
        "candidateChecks"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contributionKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verificationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt": {
          "$ref": "#/$defs/compact"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/case"
              }
            }
          },
          "required": [
            "cases"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventId",
        "contributionKey",
        "packSha256",
        "contextKey",
        "verificationDigest",
        "receipt",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "publicReady",
          "integrationStatus",
          "cases",
          "tests"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "verifiedContribution": {
            "const": true
          },
          "publicReady": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "verifiedContribution": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "received"
          }
        }
      },
      "then": {
        "required": [
          "contributionKey",
          "eventId",
          "duplicate",
          "verification"
        ],
        "properties": {
          "ok": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "recorded",
              "not-found"
            ]
          }
        }
      },
      "then": {
        "required": [
          "events",
          "contributionKey",
          "mergeStatus",
          "releaseStatus"
        ],
        "properties": {
          "ok": {
            "const": true
          }
        }
      }
    }
  ]
}
