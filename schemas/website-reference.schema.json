{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marioypolo-ui/web-extraction-capabilities/schemas/website-reference.schema.json",
  "type": "object",
  "required": ["capabilityId", "baseCapabilityVersion", "target"],
  "properties": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "baseCapabilityVersion": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "name",
        "referenceUrl",
        "match",
        "verification",
        "verifiedAt",
        "evidence"
      ]
    }
  },
  "additionalProperties": false
}
